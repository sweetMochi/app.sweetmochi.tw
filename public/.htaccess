RewriteEngine on

# HTTP 轉址至 HTTPS（僅限正式網域，本地測試不轉址）
RewriteCond %{HTTP_HOST} ^app\.sweetmochi\.tw$ [NC]
RewriteCond %{SERVER_PORT} 80
RewriteRule ^(.*)$ https://app.sweetmochi.tw/$1 [R=301,L]

# 禁止存取 FTP 部署狀態檔
RewriteRule (^|/)\.ftp-deploy-sync-state\.json$ - [F,L]

# 存在的檔案、連結或目錄直接回應
RewriteCond %{REQUEST_FILENAME} -s [OR]
RewriteCond %{REQUEST_FILENAME} -l [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^.*$ - [NC,L]

# 其餘路徑交由 Angular 路由處理
RewriteRule ^(.*) /index.html [NC,L]
